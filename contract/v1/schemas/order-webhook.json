{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "order-webhook.json",
  "title": "Webhook d'une course (order.created, order.status_changed, order.incident, order.updated)",
  "type": "object",
  "required": [
    "id",
    "event",
    "created_at",
    "data"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "event": {
      "type": "string",
      "enum": [
        "order.created",
        "order.status_changed",
        "order.incident",
        "order.updated"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "data": {
      "type": "object",
      "required": [
        "order",
        "change"
      ],
      "properties": {
        "order": {
          "$ref": "order.json"
        },
        "change": {
          "type": "object",
          "required": [
            "type",
            "from_status",
            "to_status",
            "note",
            "fields"
          ],
          "properties": {
            "type": {
              "type": "string"
            },
            "from_status": {
              "type": [
                "string",
                "null"
              ],
              "enum": [
                "pending",
                "confirmed",
                "rejected",
                "pickup_assigned",
                "pickup_in_progress",
                "picked_up",
                "at_hub",
                "delivery_assigned",
                "out_for_delivery",
                "delivered",
                "delivery_failed",
                "rescheduled",
                "return_assigned",
                "returning",
                "returned",
                "cancelled",
                "lost",
                null
              ]
            },
            "to_status": {
              "type": [
                "string",
                "null"
              ],
              "enum": [
                "pending",
                "confirmed",
                "rejected",
                "pickup_assigned",
                "pickup_in_progress",
                "picked_up",
                "at_hub",
                "delivery_assigned",
                "out_for_delivery",
                "delivered",
                "delivery_failed",
                "rescheduled",
                "return_assigned",
                "returning",
                "returned",
                "cancelled",
                "lost",
                null
              ]
            },
            "incident": {
              "type": [
                "string",
                "null"
              ]
            },
            "rescheduled_to": {
              "type": [
                "string",
                "null"
              ],
              "format": "date"
            },
            "note": {
              "type": [
                "string",
                "null"
              ]
            },
            "fields": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
