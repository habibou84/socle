{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "directory-quotes.json",
  "title": "Devis des entreprises de l'annuaire pour un lieu (POST https://jibiat.com/api/public/directory/quotes)",
  "type": "object",
  "required": [
    "data"
  ],
  "properties": {
    "data": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "slug",
          "covered",
          "total"
        ],
        "properties": {
          "slug": {
            "type": "string"
          },
          "covered": {
            "type": "boolean"
          },
          "total": {
            "type": [
              "integer",
              "null"
            ]
          },
          "zone": {
            "type": [
              "string",
              "null"
            ]
          },
          "earliest_date": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "message": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
