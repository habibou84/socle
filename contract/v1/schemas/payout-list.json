{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "payout-list.json",
  "title": "Reversements (GET /payouts)",
  "type": "object",
  "required": [
    "data",
    "meta"
  ],
  "properties": {
    "data": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "reference",
          "status"
        ],
        "properties": {
          "reference": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "net_amount": {
            "type": "integer"
          },
          "paid_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        }
      }
    },
    "meta": {
      "type": "object",
      "required": [
        "last_page"
      ],
      "properties": {
        "current_page": {
          "type": "integer"
        },
        "last_page": {
          "type": "integer"
        },
        "total": {
          "type": "integer"
        }
      }
    }
  }
}
