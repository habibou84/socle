{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "webhook-created.json",
  "title": "Adresse webhook créée (POST /webhooks)",
  "type": "object",
  "required": [
    "data",
    "secret"
  ],
  "properties": {
    "data": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "integer"
        }
      }
    },
    "secret": {
      "type": "string"
    }
  }
}
