{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "premium-card-request.json",
  "title": "Demande d'une carte Membre Premium Jibiat Marchand par une entreprise de Jibiat (POST /api/partners/v1/premium-cards)",
  "type": "object",
  "required": [
    "company",
    "merchant",
    "reason"
  ],
  "properties": {
    "company": {
      "type": "object",
      "required": [
        "slug",
        "name"
      ],
      "properties": {
        "slug": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "phone": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "merchant": {
      "type": "object",
      "required": [
        "reference",
        "name",
        "phone"
      ],
      "properties": {
        "reference": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "phone": {
          "type": "string"
        },
        "email": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "reason": {
      "type": "string",
      "enum": [
        "manual",
        "automatic"
      ]
    },
    "stats": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "delivered_90d": {
          "type": "integer"
        },
        "success_rate": {
          "type": [
            "number",
            "null"
          ]
        },
        "client_since": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "offer": {
      "type": [
        "object",
        "null"
      ],
      "description": "Depuis 1.8 : formule choisie par l'entreprise pour cette carte (sinon, celle réglée chez Jibiat Marchand)",
      "required": [
        "plan",
        "free_months",
        "discount_rate"
      ],
      "properties": {
        "plan": {
          "type": "string",
          "enum": [
            "starter",
            "pro",
            "business"
          ]
        },
        "free_months": {
          "type": "integer",
          "minimum": 0,
          "maximum": 36
        },
        "discount_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.9
        }
      }
    }
  }
}
