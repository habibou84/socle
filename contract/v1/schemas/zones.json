{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "zones.json",
  "title": "Zones (GET /zones)",
  "type": "object",
  "required": [
    "data"
  ],
  "properties": {
    "data": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "parent_id",
          "is_shipping",
          "is_active"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "parent_id": {
            "type": [
              "integer",
              "null"
            ]
          },
          "is_shipping": {
            "type": "boolean"
          },
          "is_active": {
            "type": "boolean"
          },
          "place": {
            "type": [
              "string",
              "null"
            ],
            "description": "Code du lieu de la liste commune (Jibiat\\Socle\\Places\\Places), null pour une zone propre à l'entreprise. Depuis la 1.7."
          }
        }
      }
    }
  }
}
