{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "merchant-app.json",
  "title": "Compte Jibiat Marchand d'un marchand parrainé par l'entreprise (PUT /api/public/v1/merchant-app)",
  "type": "object",
  "required": [
    "data"
  ],
  "properties": {
    "data": {
      "type": "object",
      "required": [
        "store_name",
        "store_url",
        "referred",
        "plan",
        "commission",
        "reported_at"
      ],
      "properties": {
        "store_name": {
          "type": "string"
        },
        "store_url": {
          "type": "string"
        },
        "referred": {
          "type": "boolean"
        },
        "signed_up_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "plan": {
          "type": "object",
          "required": [
            "status"
          ],
          "properties": {
            "name": {
              "type": [
                "string",
                "null"
              ]
            },
            "status": {
              "type": "string",
              "enum": [
                "trialing",
                "active",
                "past_due",
                "cancelled",
                "expired",
                "none"
              ]
            }
          }
        },
        "commission": {
          "type": "object",
          "required": [
            "rate",
            "months",
            "currency",
            "earned_total",
            "earned_month",
            "paid_total"
          ],
          "properties": {
            "rate": {
              "type": "number"
            },
            "months": {
              "type": "integer"
            },
            "ends_at": {
              "type": [
                "string",
                "null"
              ]
            },
            "currency": {
              "type": "string"
            },
            "earned_total": {
              "type": "integer"
            },
            "earned_month": {
              "type": "integer"
            },
            "paid_total": {
              "type": "integer"
            }
          }
        },
        "reported_at": {
          "type": "string"
        }
      }
    }
  }
}
